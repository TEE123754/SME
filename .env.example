# Copy to .env; pnpm db:setup generates a random local password.
APP_ENV=local-demo
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
AUTH_ADAPTER=demo
ASSISTANT_MODE=scripted
ALLOWED_ORIGINS=http://127.0.0.1:5173
# db:setup creates bootstrap credentials; db:migrate switches DATABASE_URL to restricted runtime.
DATABASE_URL=postgresql://cb_runtime:GENERATE_WITH_DB_SETUP@127.0.0.1:54329/customerbuddy
# Admin/worker values are generated by db:migrate and never enter the web bundle.
MIGRATION_DATABASE_URL=postgresql://customerbuddy:GENERATE_WITH_DB_SETUP@127.0.0.1:54329/customerbuddy
WORKER_DATABASE_URL=postgresql://cb_worker:GENERATE_WITH_DB_SETUP@127.0.0.1:54329/customerbuddy
LOCAL_DOCUMENT_PATH=.local/documents
